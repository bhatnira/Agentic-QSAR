# LLM provider selection: "nvidia" | "openrouter" | "huggingface" | "mock"
LLM_PROVIDER=nvidia
LLM_MODEL=openai/gpt-oss-20b

# NVIDIA NIM / build.nvidia.com (nvapi-... key from https://build.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=openai/gpt-oss-20b

# OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Hugging Face Inference Endpoints / serverless inference API
HF_TOKEN=
HF_MODEL=qwen/Qwen2.5-7B-Instruct

# Optional: MLflow tracking URI (defaults to local ./mlruns)
MLFLOW_TRACKING_URI=

# Optional: local run output directory
CTA_QSAR_OUTPUT_DIR=runs